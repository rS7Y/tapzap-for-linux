+static void acpi_alarm(void)
+{
+    /* Enable ICH9 ACPI at PMBASE 0x600, including the RTC fixed event. */
+    outl(0xcf8, 0x8000f840);
+    outl(0xcfc, 0x601);
+    outl(0xcf8, 0x8000f844);
+    outb(0xcfc, 0x80);
+    outw(0x604, 1);
+    outw(0x600, 0x400);
+    outw(0x602, 0x400);
+    set_datetime(REG_B_24H, 0x02, 0x04, 0x58, 0x02, 0x02, 0x2011);
+    cmos_write(RTC_HOURS_ALARM, 0x02);
+    cmos_write(RTC_MINUTES_ALARM, 0x04);
+    cmos_write(RTC_SECONDS_ALARM, 0x59);
+    cmos_read(RTC_REG_C);
+    cmos_write(RTC_REG_B, REG_B_24H | REG_B_AIE);
+    clock_step(1000000000LL);
+    g_assert_cmphex(inw(0x600) & 0x400, ==, 0x400);
+    g_assert_true(get_irq(9));
+    cmos_write(RTC_REG_B, REG_B_24H);
+    cmos_read(RTC_REG_C);
+    outw(0x600, 0x400);
+    g_assert_false(get_irq(9));
+    outw(0x602, 0);
+
+    /* A masked fixed event still latches; enabling it asserts SCI. */
+    set_datetime(REG_B_24H, 0x02, 0x04, 0x58, 0x02, 0x02, 0x2011);
+    cmos_write(RTC_REG_B, REG_B_24H | REG_B_AIE);
+    clock_step(1000000000LL);
+    g_assert_cmphex(inw(0x600) & 0x400, ==, 0x400);
+    g_assert_false(get_irq(9));
+    outw(0x602, 0x400);
+    g_assert_true(get_irq(9));
+    cmos_write(RTC_REG_B, REG_B_24H);
+    cmos_read(RTC_REG_C);
+    outw(0x600, 0x400);
+
+    /* AF can latch before AIE is enabled, just as for the legacy IRQ. */
+    set_datetime(REG_B_24H, 0x02, 0x04, 0x58, 0x02, 0x02, 0x2011);
+    clock_step(1000000000LL);
+    g_assert_cmphex(inw(0x600) & 0x400, ==, 0);
+    g_assert_false(get_irq(9));
+    cmos_write(RTC_REG_B, REG_B_24H | REG_B_AIE);
+    g_assert_cmphex(inw(0x600) & 0x400, ==, 0x400);
+    g_assert_true(get_irq(9));
+    cmos_write(RTC_REG_B, REG_B_24H);
+    cmos_read(RTC_REG_C);
+    outw(0x600, 0x400);
+    g_assert_false(get_irq(9));
+    outw(0x602, 0);
+}
