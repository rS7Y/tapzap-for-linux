#!/usr/bin/env bash
set -euo pipefail
root=$(dirname "$(readlink -f -- "$0")")
app="$root/bin/tapzap"
export TAPZAP_HYPRLAND_HELPER="$root/bin/tapzap-ctm"
export TAPZAP_ASSETS="$root/assets"
# Preserve the stable current/ or /usr/bin launcher across package updates.
case "$0" in
  /*) export TAPZAP_LAUNCHER="$0" ;;
  *) export TAPZAP_LAUNCHER="$(pwd)/$0" ;;
esac
export TAPZAP_FRAMELESS=1
export TAPZAP_SCALE="${TAPZAP_SCALE:-0.8}"
unset TAPZAP_OVERLAY TAPZAP_WINDOWED TAPZAP_GNOME_HELPER TAPZAP_PLASMA_HELPER TAPZAP_WLR_ENABLE TAPZAP_START_HIDDEN
command=${1:-show}
if [[ $command == selftest ]]; then exec "$app" selftest; fi
if [[ $command == status || $command == hide || $command == quit ]]; then exec "$app" "$command"; fi
if [[ $command == on || $command == off || $command == toggle ]]; then exec "$app" "$command"; fi
if [[ $command != show && $command != start-hidden ]]; then
  echo 'Usage: tapzap-omarchy [show|on|off|toggle|hide|status|quit|start-hidden|selftest]' >&2
  exit 2
fi
if "$app" status >/dev/null 2>&1; then
  [[ $command == start-hidden ]] && exit 0
  exec "$app" show
fi
if [[ -z ${WAYLAND_DISPLAY:-} || -z ${DISPLAY:-} || -z ${XDG_RUNTIME_DIR:-} ]]; then
  echo 'Open this trial from your Omarchy desktop with XWayland enabled.' >&2
  exit 2
fi
[[ $command == start-hidden ]] && export TAPZAP_START_HIDDEN=1
# Backend probes the actual Wayland socket for CTM v2 before filtering. No X11 fallback.
exec "$app" gui
