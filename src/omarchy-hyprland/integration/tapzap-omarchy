set -euo pipefail
root=$(dirname "$(readlink -f -- "$0")")
app="$root/bin/tapzap"
export TAPZAP_HYPRLAND_HELPER="$root/bin/tapzap-ctm"
export TAPZAP_ASSETS="$root/assets"
# Preserve the stable current/ or /usr/bin launcher across package updates.
case "$0" in
  /*) export TAPZAP_LAUNCHER="$0" ;;
  *) export TAPZAP_LAUNCHER="$(pwd)/$0" ;;
esac
export TAPZAP_FRAMELESS=1
export TAPZAP_SCALE="${TAPZAP_SCALE:-0.8}"
unset TAPZAP_OVERLAY TAPZAP_WINDOWED TAPZAP_GNOME_HELPER TAPZAP_PLASMA_HELPER TAPZAP_WLR_ENABLE TAPZAP_START_HIDDEN
command=${1:-show}
if [[ $command == update ]]; then
  if [[ $# -gt 1 ]]; then
    python3 "$root/setup/install.py" --archive "$2"
  else
    python3 "$root/setup/install.py" --download
  fi
  exec "$TAPZAP_LAUNCHER" start-hidden
fi
if [[ $command == uninstall ]]; then exec python3 "$root/setup/install.py" --uninstall; fi
if [[ $command == version ]]; then exec python3 "$root/setup/install.py" --version; fi
if [[ $command == engine ]]; then exec "$app" managed-daemon; fi
if [[ $command == engine-resume ]]; then exec "$app" resume-daemon; fi
if [[ $command == set || $command == preset || $command == schedule ]]; then exec "$app" "$@"; fi
# Native Omarchy 4 plugin owns the popup and the engine lifetime. Older shells
# can use the retained Cairo front end explicitly with TAPZAP_CAIRO=1.
plugin="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/app.tapzap/manifest.json"
if [[ -f $plugin && ${TAPZAP_CAIRO:-0} != 1 ]]; then
  export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
  if [[ $command == show || $command == hide ]]; then
    # Plugin discovery is asynchronous immediately after installation/reload.
    for attempt in {1..20}; do
      if omarchy-shell app.tapzap "$command" 2>/dev/null; then exit 0; fi
      sleep 0.1
    done
    echo 'TAP ZAP plugin is not ready. Enable it with: omarchy plugin enable app.tapzap' >&2
    exit 1
  fi
  if [[ $command == start-hidden ]]; then
    for attempt in {1..20}; do
      if omarchy-shell app.tapzap.engine start; then exit 0; fi
      sleep 0.5
    done
    echo 'Omarchy shell is not ready. Open TAP ZAP from the bar.' >&2
    exit 1
  fi
fi
if [[ $command == selftest ]]; then exec "$app" selftest; fi
if [[ $command == status || $command == hide || $command == quit ]]; then exec "$app" "$command"; fi
if [[ $command == on || $command == off || $command == toggle ]]; then exec "$app" "$command"; fi
if [[ $command != show && $command != start-hidden ]]; then
  echo 'Usage: tapzap [show|on|off|toggle|hide|status|quit|set|preset|schedule|start-hidden|selftest|version|update [ARCHIVE]|uninstall]' >&2
  exit 2
fi
if "$app" status >/dev/null 2>&1; then
  [[ $command == start-hidden ]] && exit 0
  exec "$app" show
fi
if [[ -z ${WAYLAND_DISPLAY:-} || -z ${DISPLAY:-} || -z ${XDG_RUNTIME_DIR:-} ]]; then
  echo 'Open TAP ZAP from your Omarchy desktop with XWayland enabled.' >&2
  exit 2
fi
[[ $command == start-hidden ]] && export TAPZAP_START_HIDDEN=1
# Backend probes the actual Wayland socket for CTM v2 before filtering. No X11 fallback.
exec "$app" gui
